rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(hh) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hh)).data.members;
    }

    // Jede Person sieht nur ihr eigenes Profil (welcher Haushalt, wer sie ist)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hh} {
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // Mitglieder dürfen alles ändern; Nicht-Mitglieder dürfen sich nur selbst hinzufügen (Beitritt per Code)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && resource.data.members.size() < 2)
      );

      match /days/{day} {
        allow read, write: if isMember(hh);
      }
    }
  }
}

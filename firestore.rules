rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function household(hh) {
      return get(/databases/$(database)/documents/households/$(hh)).data;
    }
    function isMember(hh) {
      return request.auth != null && request.auth.uid in household(hh).members;
    }
    // "a" (Person 1) oder "b" (Person 2), fest beim Anlegen bzw. Beitreten vergeben
    function myRole(hh) {
      return household(hh).roles[request.auth.uid];
    }
    // Routinen, die man bearbeiten darf: die eigenen, "ab" (beide einzeln) und "s" (gemeinsam)
    function editable(hh, who) {
      return who in [myRole(hh), 'ab', 's'];
    }
    // Aufgabe: Titel vorhanden, von a oder b, an a, b oder s (gemeinsam)
    function validTask(t) {
      return t.title is string && t.title.size() > 0 && t.title.size() <= 200
        && t.from in ['a', 'b'] && t.to in ['a', 'b', 's'];
    }

    // Jede Person sieht nur ihr eigenes Profil (welcher Haushalt)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hh} {
      // Anlegen nur mit sich selbst als einzigem Mitglied und einer Rolle a oder b
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] in ['a', 'b'];
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if request.auth != null && (
        // Mitglieder ändern nur Namen und Bereiche; Mitglieder und Rollen bleiben fest
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'cats']))
        // Beitritt per Code: nur sich selbst, mit der noch freien Rolle, höchstens zwei Personen
        || (resource.data.members.size() < 2
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] in ['a', 'b']
          && !(request.resource.data.roles[request.auth.uid] in resource.data.roles.values())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles']))
      );

      // Routinen: alle Mitglieder sehen alles, bearbeiten nur eigene und gemeinsame
      match /routines/{rid} {
        allow read: if isMember(hh);
        allow create: if isMember(hh) && editable(hh, request.resource.data.who);
        allow update: if isMember(hh) && editable(hh, resource.data.who) && editable(hh, request.resource.data.who);
        allow delete: if isMember(hh) && editable(hh, resource.data.who);
      }

      // Haken: ein Dokument je Person und Tag, Name "<a|b|s>_<JJJJ-MM-TT>".
      // Seit Version 7 dürfen beide auch für die andere Person abhaken.
      match /days/{id} {
        allow read: if isMember(hh);
        allow write: if isMember(hh) && id.matches('^[abs]_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Aufgaben (seit Version 7): beide dürfen alle Aufgaben vergeben, abhaken, ändern und löschen.
      match /tasks/{tid} {
        allow read, delete: if isMember(hh);
        allow create, update: if isMember(hh) && validTask(request.resource.data);
      }
    }
  }
}
